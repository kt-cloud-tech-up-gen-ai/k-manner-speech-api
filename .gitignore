# ==========================================
# Byte-compiled / optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# ==========================================
# Distribution / packaging
# ==========================================
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so cause name conflicts
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.lprof
.hypothesis/
.pytest_cache/
cover/

# ==========================================
# Environments (가상환경)
# ==========================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Environment Variables & Secrets (환경변수)
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# IDEs & Editors
# ==========================================
# PyCharm
.idea/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Jupyter Notebook
.ipynb_checkpoints

# ==========================================
# Database / Logs
# ==========================================
*.log
*.sqlite3
*.db
# ==========================================
# AI 코딩 도구 개인 산출물 (`.claude/skills`만 팀 공유)
# ==========================================
# 디렉터리 자체가 아니라 "내용물"을 제외한다.
# git은 제외된 디렉터리 안으로 내려가지 않으므로 `.claude/` 로 막으면
# 아래 `!` 예외가 전혀 동작하지 않는다.
.claude/*
# 공유 스킬 심링크(-> ../.agents/skills)는 커밋한다.
!.claude/skills

# AI 도구가 만든 분석·보고 문서. 개인 작업물로 남긴다.
# plan-acc 감사 문서에 이 저장소와 무관한 개인 프로젝트 이름이 들어 있어
# 팀 저장소에 올리지 않는다. 공유가 필요하면 파일 단위로 `git add -f`.
claudedocs/
