# Google Gemini API 키 (app/routers/routers.py 에서 사용)
# GOOGLE_API_KEY 를 먼저 확인하고, 없으면 GEMINI_API_KEY 를 사용합니다.
# 둘 중 하나만 설정하면 됩니다. 미설정 시 LLM 호출 없이 기본 문구를 반환합니다.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# PostgreSQL 접속 문자열 (app/core/db.py)
# supabase를 IPv4(Pro plan만 가능)를 사용하지 않을 때, 해경 방법: 우회하면 된다.
# postgresql+psycopg://<username>[:password]@<aws_region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/k_manner_speech


# ElevenLabs TTS (app/services/tts.py)
ELEVENLABS_API_KEY=
# persona YAML에 voice_id가 없을 때 사용할 기본 음성 ID
ELEVENLABS_VOICE_ID=
# 선택. 기본값 eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Supabase Auth (app/core/auth.py)
# Dashboard > Project Settings > API 에서 확인
# Project URL 예: https://<project-ref>.supabase.co
SUPABASE_URL=
# anon(public) 키. 대시보드 Project Settings > API Keys 의 "Publishable key"(sb_publishable_...)
# 또는 Legacy API keys 탭의 anon 키(eyJ...). service_role/Secret 키는 절대 넣지 말 것.
SUPABASE_ANON_KEY=
